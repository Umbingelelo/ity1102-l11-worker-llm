# Copia este archivo:  cp .env.example .env   y completa los valores. El .env NUNCA va a Git.

# Tu caso: rfm, fraude, chatbot o recomendacion. El endpoint es el de L10: l10-<caso>
CASO=fraude
ENDPOINT=
UMBRAL=0.5

# Claves que aceptará la API en el header X-API-Key, separadas por coma. Inventa una larga:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=
LIMITE_POR_MINUTO=60

# La clave que creaste en build.nvidia.com y el modelo que publicó el docente en el foro
NVIDIA_API_KEY=
NVIDIA_MODEL=

# En la EC2: <tu-ip-elastica-con-guiones>.sslip.io   (ejemplo: 3-85-10-20.sslip.io)
DOMINIO=localhost

# Lo completa el pipeline. A mano, déjalo así
IMAGEN=ity1102-l11
TAG=latest
